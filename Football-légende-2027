<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Football 3D</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div id="game">
    <div id="score">⚽ Score : <span id="scoreValue">0</span></div>
    <div id="message">Football 3D</div>

    <div id="controls">
      <div class="movement">
        <button id="up">▲</button>
        <div>
          <button id="left">◀</button>
          <button id="down">▼</button>
          <button id="right">▶</button>
        </div>
      </div>

      <button id="shoot">TIR ⚽</button>
    </div>
  </div>

  <script type="module" src="game.js"></script>
</body>
</html>
import * as THREE from
  "https://cdn.jsdelivr.net/npm/three@0.161.0/build/three.module.js";

const scene = new THREE.Scene();

scene.background = new THREE.Color(0x87ceeb);

const camera = new THREE.PerspectiveCamera(
  60,
  window.innerWidth / window.innerHeight,
  0.1,
  1000
);

camera.position.set(0, 12, 16);
camera.lookAt(0, 0, 0);

const renderer = new THREE.WebGLRenderer({
  antialias: true
});

renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.shadowMap.enabled = true;

document.getElementById("game").appendChild(renderer.domElement);


// ==========================
// LUMIÈRES
// ==========================

const sunlight = new THREE.DirectionalLight(0xffffff, 2);
sunlight.position.set(10, 20, 10);
sunlight.castShadow = true;
scene.add(sunlight);

const ambient = new THREE.AmbientLight(0xffffff, 0.7);
scene.add(ambient);


// ==========================
// TERRAIN
// ==========================

const fieldGeometry = new THREE.BoxGeometry(20, 0.2, 32);

const fieldMaterial = new THREE.MeshStandardMaterial({
  color: 0x168a35
});

const field = new THREE.Mesh(
  fieldGeometry,
  fieldMaterial
);

field.receiveShadow = true;
scene.add(field);


// Lignes du terrain
function createLine(x, z, width, depth) {

  const geometry = new THREE.BoxGeometry(
    width,
    0.03,
    depth
  );

  const material = new THREE.MeshBasicMaterial({
    color: 0xffffff
  });

  const line = new THREE.Mesh(
    geometry,
    material
  );

  line.position.set(x, 0.12, z);

  scene.add(line);
}

createLine(0, -16, 20, 0.12);
createLine(0, 16, 20, 0.12);
createLine(-10, 0, 0.12, 32);
createLine(10, 0, 0.12, 32);
createLine(0, 0, 20, 0.08);


// ==========================
// BUT
// ==========================

const goalMaterial = new THREE.MeshStandardMaterial({
  color: 0xffffff
});

function createPost(x, y, z, sx, sy, sz) {

  const geometry = new THREE.BoxGeometry(
    sx,
    sy,
    sz
  );

  const post = new THREE.Mesh(
    geometry,
    goalMaterial
  );

  post.position.set(x, y, z);
  post.castShadow = true;

  scene.add(post);
}

createPost(-4, 1.5, -15.5, 0.25, 3, 0.25);
createPost(4, 1.5, -15.5, 0.25, 3, 0.25);
createPost(0, 3, -15.5, 8, 0.25, 0.25);


// ==========================
// JOUEUR
// ==========================

const player = new THREE.Group();

const body = new THREE.Mesh(
  new THREE.CylinderGeometry(0.55, 0.65, 1.5, 16),
  new THREE.MeshStandardMaterial({
    color: 0x1266d3
  })
);

body.position.y = 1.2;
body.castShadow = true;

player.add(body);


const head = new THREE.Mesh(
  new THREE.SphereGeometry(0.42, 16, 16),
  new THREE.MeshStandardMaterial({
    color: 0xd79b70
  })
);

head.position.y = 2.25;
head.castShadow = true;

player.add(head);

player.position.set(0, 0, 8);

scene.add(player);


// ==========================
// BALLON
// ==========================

const ball = new THREE.Mesh(
  new THREE.SphereGeometry(0.35, 20, 20),
  new THREE.MeshStandardMaterial({
    color: 0xffffff
  })
);

ball.castShadow = true;

ball.position.set(
  0,
  0.4,
  6.5
);

scene.add(ball);


// ==========================
// CONTRÔLES
// ==========================

const keys = {
  up: false,
  down: false,
  left: false,
  right: false
};

function setupButton(id, key) {

  const button = document.getElementById(id);

  button.addEventListener("pointerdown", e => {
    e.preventDefault();
    keys[key] = true;
  });

  button.addEventListener("pointerup", e => {
    e.preventDefault();
    keys[key] = false;
  });

  button.addEventListener("pointerleave", () => {
    keys[key] = false;
  });

  button.addEventListener("pointercancel", () => {
    keys[key] = false;
  });
}

setupButton("up", "up");
setupButton("down", "down");
setupButton("left", "left");
setupButton("right", "right");


// ==========================
// CLAVIER
// ==========================

window.addEventListener("keydown", e => {

  if (e.key === "ArrowUp" || e.key === "w")
    keys.up = true;

  if (e.key === "ArrowDown" || e.key === "s")
    keys.down = true;

  if (e.key === "ArrowLeft" || e.key === "a")
    keys.left = true;

  if (e.key === "ArrowRight" || e.key === "d")
    keys.right = true;
});

window.addEventListener("keyup", e => {

  if (e.key === "ArrowUp" || e.key === "w")
    keys.up = false;

  if (e.key === "ArrowDown" || e.key === "s")
    keys.down = false;

  if (e.key === "ArrowLeft" || e.key === "a")
    keys.left = false;

  if (e.key === "ArrowRight" || e.key === "d")
    keys.right = false;
});


// ==========================
// TIR
// ==========================

let ballVelocity = new THREE.Vector3();

let score = 0;

document.getElementById("shoot")
  .addEventListener("pointerdown", () => {

    const distance = player.position.distanceTo(
      ball.position
    );

    if (distance < 2.2) {

      ballVelocity.set(
        0,
        0.12,
        -0.45
      );

      ball.position.x = player.position.x;
      ball.position.z = player.position.z - 1;

      document.getElementById("message")
        .textContent = "TIR ! ⚽";
    }
  });


// ==========================
// COLLISION / BUT
// ==========================

function checkGoal() {

  if (
    ball.position.z < -15 &&
    Math.abs(ball.position.x) < 4
  ) {

    score++;

    document.getElementById("scoreValue")
      .textContent = score;

    document.getElementById("message")
      .textContent = "BUT ! 🎉";

    ball.position.set(
      0,
      0.4,
      6.5
    );

    ballVelocity.set(0, 0, 0);
  }
}


// ==========================
// ANIMATION
// ==========================

const clock = new THREE.Clock();

function animate() {

  requestAnimationFrame(animate);

  const delta = Math.min(
    clock.getDelta(),
    0.05
  );

  const speed = 6 * delta;

  if (keys.up)
    player.position.z -= speed;

  if (keys.down)
    player.position.z += speed;

  if (keys.left)
    player.position.x -= speed;

  if (keys.right)
    player.position.x += speed;


  // Limites du terrain
  player.position.x = THREE.MathUtils.clamp(
    player.position.x,
    -9,
    9
  );

  player.position.z = THREE.MathUtils.clamp(
    player.position.z,
    -14,
    14
  );


  // Ballon
  ball.position.add(
    ballVelocity
  );

  ballVelocity.multiplyScalar(0.97);

  // Gravité
  ball.position.y = Math.max(
    0.35,
    ball.position.y - 0.01
  );


  // Suivre le joueur
  const cameraTarget = new THREE.Vector3(
    player.position.x,
    0,
    player.position.z
  );

  camera.position.x +=
    (player.position.x - camera.position.x) *
    0.08;

  camera.position.z +=
    (player.position.z + 13 - camera.position.z) *
    0.08;

  camera.lookAt(
    cameraTarget.x,
    0,
    cameraTarget.z - 4
  );


  checkGoal();

  renderer.render(
    scene,
    camera
  );
}

animate();


// ==========================
// REDIMENSIONNEMENT
// ==========================

window.addEventListener(
  "resize",
  () => {

    camera.aspect =
      window.innerWidth /
      window.innerHeight;

    camera.updateProjectionMatrix();

    renderer.setSize(
      window.innerWidth,
      window.innerHeight
    );
  }
);* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
}

body {
  overflow: hidden;
  background: #111;
  font-family: Arial, sans-serif;
  touch-action: none;
}

#game {
  width: 100vw;
  height: 100vh;
  position: relative;
}

canvas {
  display: block;
  width: 100%;
  height: 100%;
}

#score {
  position: absolute;
  top: 15px;
  left: 15px;
  z-index: 10;
  color: white;
  background: rgba(0, 0, 0, 0.55);
  padding: 10px 15px;
  border-radius: 12px;
  font-size: 18px;
  font-weight: bold;
}

#message {
  position: absolute;
  top: 15px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  color: white;
  font-size: 22px;
  font-weight: bold;
  text-shadow: 2px 2px 5px #000;
}

#controls {
  position: absolute;
  bottom: 20px;
  left: 0;
  width: 100%;
  z-index: 20;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 20px;
  pointer-events: none;
}

.movement {
  pointer-events: auto;
  text-align: center;
}

.movement button,
#shoot {
  border: none;
  color: white;
  font-weight: bold;
  background: rgba(20, 20, 20, 0.75);
  border: 2px solid rgba(255,255,255,0.5);
  box-shadow: 0 4px 10px rgba(0,0,0,0.4);
  touch-action: none;
}

.movement button {
  width: 55px;
  height: 55px;
  margin: 3px;
  border-radius: 50%;
  font-size: 20px;
}

#shoot {
  pointer-events: auto;
  width: 95px;
  height: 95px;
  border-radius: 50%;
  font-size: 16px;
  background: rgba(190, 30, 30, 0.85);
}

.movement button:active,
#shoot:active {
  transform: scale(0.92);
}
